{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ucc.local/schemas/body-contacts.v1.schema.json",
  "title": "UCC complete saved-Action outward-hand closed-skin winding observations v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy",
    "measurement",
    "bindings",
    "paired",
    "source_frame_count",
    "source_first_frame",
    "fps",
    "original",
    "fitted",
    "original_review_verification",
    "fitted_frames_verified",
    "originals_unchanged",
    "contact_quality_verified",
    "animation_visual_quality_verified",
    "engine_import_verified"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "policy": {
      "const": "CLOSED_SKIN_HAND_OUTWARD_WINDING_V1"
    },
    "measurement": {
      "const": "FRESH_SAVED_ACTION_CLOSED_SKIN_V1"
    },
    "bindings": {
      "oneOf": [
        {
          "$ref": "#/$defs/source_bindings"
        },
        {
          "$ref": "#/$defs/fit_bindings"
        }
      ]
    },
    "paired": {
      "type": "boolean"
    },
    "source_frame_count": {
      "type": "integer",
      "minimum": 2,
      "maximum": 2000
    },
    "source_first_frame": {
      "type": "integer"
    },
    "fps": {
      "type": "number",
      "minimum": 1,
      "maximum": 240
    },
    "original": {
      "$ref": "#/$defs/variant"
    },
    "fitted": {
      "oneOf": [
        {
          "$ref": "#/$defs/variant"
        },
        {
          "type": "null"
        }
      ]
    },
    "original_review_verification": {
      "type": "object"
    },
    "fitted_frames_verified": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2000
    },
    "originals_unchanged": {
      "const": true
    },
    "contact_quality_verified": {
      "const": false
    },
    "animation_visual_quality_verified": {
      "const": false
    },
    "engine_import_verified": {
      "const": false
    }
  },
  "$defs": {
    "hit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_triangles",
        "nonzero_triangles",
        "ambiguous_triangles"
      ],
      "properties": {
        "selected_triangles": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99999
          }
        },
        "nonzero_triangles": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99999
          }
        },
        "ambiguous_triangles": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99999
          }
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame",
        "skin_sha256",
        "triangle_sha256",
        "observation"
      ],
      "properties": {
        "frame": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "skin_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "triangle_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "observation": {
          "oneOf": [
            {
              "$ref": "#/$defs/observation"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "status",
        "reason",
        "hands",
        "head",
        "parents",
        "deform_bones",
        "world_matrix",
        "region_bones",
        "region_vertex_counts",
        "frame_count",
        "frames",
        "contact_quality_verified",
        "engine_import_verified"
      ],
      "properties": {
        "policy": {
          "const": "CLOSED_SKIN_HAND_OUTWARD_WINDING_V1"
        },
        "status": {
          "enum": [
            "CHECKED",
            "UNAVAILABLE"
          ]
        },
        "reason": {
          "enum": [
            "",
            "CENTRAL_BRANCH_UNAVAILABLE",
            "SKIN_DEGENERATE_GEOMETRY",
            "SKIN_DUPLICATE_FACE",
            "SKIN_GEOMETRY_BUDGET",
            "SKIN_HAND_SELECTION_BUDGET",
            "SKIN_HAND_SELECTION_OVERLAP",
            "SKIN_INVALID_GEOMETRY",
            "SKIN_NONMANIFOLD_VERTEX",
            "SKIN_NONPOSITIVE_VOLUME",
            "SKIN_OPEN_OR_UNORIENTED",
            "SKIN_RAY_BUDGET",
            "SKIN_UNSUPPORTED_TOPOLOGY",
            "WEIGHTED_REGIONS_UNAVAILABLE"
          ]
        },
        "hands": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "left",
            "right"
          ],
          "properties": {
            "left": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "right": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "head": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "parents": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 256,
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "deform_bones": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true
        },
        "world_matrix": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000
          }
        },
        "region_bones": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "left_hand": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "uniqueItems": true
            },
            "right_hand": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "uniqueItems": true
            },
            "central_body": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "uniqueItems": true
            }
          },
          "oneOf": [
            {
              "maxProperties": 0
            },
            {
              "required": [
                "left_hand",
                "right_hand",
                "central_body"
              ]
            }
          ]
        },
        "region_vertex_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "left_hand": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "right_hand": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "central_body": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            }
          },
          "oneOf": [
            {
              "maxProperties": 0
            },
            {
              "required": [
                "left_hand",
                "right_hand",
                "central_body"
              ]
            }
          ]
        },
        "frame_count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 2000
        },
        "frames": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2000,
          "items": {
            "$ref": "#/$defs/frame"
          }
        },
        "contact_quality_verified": {
          "const": false
        },
        "engine_import_verified": {
          "const": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "CHECKED"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": ""
              },
              "frames": {
                "items": {
                  "properties": {
                    "observation": {
                      "$ref": "#/$defs/observation"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "UNAVAILABLE"
              }
            }
          },
          "then": {
            "properties": {
              "frames": {
                "items": {
                  "properties": {
                    "observation": {
                      "type": "null"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "source_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_sha256",
        "snapshot_sha256",
        "mapping_sha256",
        "master_sha256",
        "review_sha256",
        "timeline_sha256"
      ],
      "properties": {
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mapping_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "master_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "review_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "timeline_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "fit_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_sha256",
        "snapshot_sha256",
        "mapping_sha256",
        "master_sha256",
        "review_sha256",
        "timeline_sha256",
        "fit_sha256",
        "fitted_sha256",
        "fit_report_sha256"
      ],
      "properties": {
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mapping_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "master_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "review_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "timeline_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fit_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fitted_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fit_report_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagonal_world",
        "offset_world",
        "signed_volume_world",
        "ray_queries",
        "left",
        "right"
      ],
      "properties": {
        "diagonal_world": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "offset_world": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "signed_volume_world": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ray_queries": {
          "type": "integer",
          "minimum": 6,
          "maximum": 1000000
        },
        "left": {
          "$ref": "#/$defs/hit"
        },
        "right": {
          "$ref": "#/$defs/hit"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "paired": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "bindings": {
            "$ref": "#/$defs/fit_bindings"
          },
          "fitted": {
            "$ref": "#/$defs/variant"
          },
          "fitted_frames_verified": {
            "minimum": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "paired": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "bindings": {
            "$ref": "#/$defs/source_bindings"
          },
          "fitted": {
            "type": "null"
          },
          "fitted_frames_verified": {
            "const": 0
          }
        }
      }
    }
  ]
}
