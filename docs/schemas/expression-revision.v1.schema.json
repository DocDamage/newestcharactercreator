{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UCC expression-preserving master transition receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy",
    "library_sha256",
    "source_master_sha256",
    "master_sha256",
    "operation",
    "inspection_sha256",
    "observation_sha256",
    "expression_keys_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "policy": {
      "const": "BOUNDED_MPFB_EXPRESSION_UNITS_V1"
    },
    "library_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_master_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "master_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "operation": {
      "enum": [
        "body_generation",
        "body_refit",
        "face_revision"
      ]
    },
    "inspection_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observation_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "expression_keys_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
