{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UCC Blender worker response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "job_id",
    "operation",
    "status",
    "details",
    "error"
  ],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "operation": {
      "enum": [
        "inspect_environment",
        "inspect_character",
        "create_human",
        "export_preview_glb",
        "refit_human",
        "verify_skin_deformation",
        "verify_keyframed_timeline",
        "verify_local_bvh_motion",
        "verify_multi_bvh_chain",
        "verify_calibrated_bvh_chain",
        "verify_reviewed_bvh_chain",
        "inspect_fbx_animation",
        "verify_native_fbx_body",
        "reopen_native_fbx_body",
        "cache_native_fbx_body",
        "stage_mpfb_face",
        "verify_mpfb_face",
        "inspect_mpfb_face_assets",
        "build_mpfb_hand_assets",
        "verify_mpfb_hand_assets",
        "stage_mpfb_hand_revision",
        "verify_mpfb_hand_revision",
        "inspect_mpfb_hand_bounds",
        "stage_mpfb_expression_keys",
        "verify_mpfb_expression_keys",
        "inspect_mpfb_expression_keys"
      ]
    },
    "status": {
      "enum": [
        "ok",
        "error"
      ]
    },
    "details": {
      "type": "object"
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
