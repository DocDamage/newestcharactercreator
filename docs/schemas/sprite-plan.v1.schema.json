{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UCC Sprite RenderPlan metadata only",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "resolution", "fps", "camera", "rendered", "frames"],
  "properties": {
    "schema_version": {"const": 1},
    "resolution": {"type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": {"width": {"type": "integer", "minimum": 16, "maximum": 2048}, "height": {"type": "integer", "minimum": 16, "maximum": 2048}}},
    "fps": {"type": "integer", "minimum": 1, "maximum": 120},
    "camera": {"type": "object", "additionalProperties": false, "required": ["yaw_deg", "pitch_deg", "roll_deg", "orthographic_scale", "angles"], "properties": {"yaw_deg": {"type": "number"}, "pitch_deg": {"type": "number"}, "roll_deg": {"type": "number"}, "orthographic_scale": {"type": "number", "exclusiveMinimum": 0}, "angles": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "number"}}}},
    "rendered": {"const": false},
    "frames": {"type": "array", "maxItems": 4096, "items": {"type": "object", "additionalProperties": false, "required": ["clip", "direction_index", "yaw_deg", "frame_index", "timestamp_s", "file_name"], "properties": {"clip": {"type": "string"}, "direction_index": {"type": "integer", "minimum": 0}, "yaw_deg": {"type": "number"}, "frame_index": {"type": "integer", "minimum": 0}, "timestamp_s": {"type": "number", "minimum": 0}, "file_name": {"type": "string"}}}}
  }
}
