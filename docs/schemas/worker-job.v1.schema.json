{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UCC isolated Blender worker request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "job_id",
    "operation",
    "input_project",
    "options"
  ],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "operation": {
      "enum": [
        "inspect_environment",
        "inspect_character",
        "create_human",
        "export_preview_glb",
        "refit_human",
        "verify_skin_deformation",
        "verify_keyframed_timeline",
        "verify_local_bvh_motion",
        "verify_multi_bvh_chain",
        "verify_calibrated_bvh_chain",
        "verify_reviewed_bvh_chain",
        "inspect_fbx_animation",
        "verify_native_fbx_body",
        "reopen_native_fbx_body",
        "cache_native_fbx_body",
        "verify_native_surface_review",
        "fit_native_fbx_body",
        "measure_native_fit",
        "verify_native_fit",
        "cache_native_fit",
        "propose_native_contact_fit"
      ]
    },
    "input_project": {
      "type": [
        "string",
        "null"
      ]
    },
    "options": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "verify_reviewed_bvh_chain"
          }
        }
      },
      "then": {
        "properties": {
          "options": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "axis_profile",
              "reviewed_mapping"
            ],
            "properties": {
              "axis_profile": {
                "enum": [
                  "Y_UP_TO_Z_UP",
                  "Z_UP_IDENTITY"
                ]
              },
              "source_rest_profile_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "reviewed_mapping": {
                "type": "array",
                "minItems": 3,
                "maxItems": 64,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source",
                    "target"
                  ],
                  "properties": {
                    "source": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
                    },
                    "target": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
                    }
                  }
                }
              },
              "source_frame_conversion": {
                "type": "string",
                "const": "BVH_XYZ_FIRST_FRAME_DELTA_TO_BONE_V1"
              },
              "render_private_frames": {
                "type": "boolean",
                "const": true
              }
            },
            "dependentRequired": {
              "source_frame_conversion": [
                "source_rest_profile_sha256"
              ],
              "render_private_frames": [
                "source_frame_conversion"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "inspect_fbx_animation"
          }
        }
      },
      "then": {
        "properties": {
          "input_project": {
            "type": "null"
          },
          "options": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_sha256"
            ],
            "properties": {
              "source_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "verify_native_fbx_body"
          }
        }
      },
      "then": {
        "properties": {
          "input_project": {
            "const": "candidate.blend"
          },
          "options": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_sha256",
              "snapshot_sha256",
              "mapping_sha256",
              "master_sha256",
              "render_private_frames"
            ],
            "properties": {
              "source_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "snapshot_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "mapping_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "master_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "render_private_frames": {
                "type": "boolean"
              }
