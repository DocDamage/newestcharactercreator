{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UCC isolated Blender worker request v1",
  "type": "object", "additionalProperties": false,
  "required": ["protocol_version", "job_id", "operation", "input_project", "options"],
  "properties": {
    "protocol_version": {"const": 1},
    "job_id": {"type": "string", "format": "uuid"},
    "operation": {"enum": ["inspect_environment", "inspect_character", "create_human"]},
    "input_project": {"type": ["string", "null"]},
    "options": {"type": "object"}
  }
}
